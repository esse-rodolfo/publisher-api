FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
# Versao fixa, nao @latest: o lockfile aqui e lockfileVersion 9.0, e um
# `pnpm@latest` faz o build mudar sozinho quando o pnpm lanca major. Build
# reproduzivel vale mais que estar na ultima versao.
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate
WORKDIR /app

FROM base AS deps
# packages/ e pnpm-workspace.yaml entram ANTES do install: @publisher/scene-engine
# e dependencia `file:./packages/scene-engine`, entao sem a pasta o pnpm morre com
# ENOENT scandir '/app/packages/scene-engine' e o build inteiro cai.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm prisma generate && pnpm build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY package.json ./
EXPOSE 3001
# node -e, nao curl: a imagem runtime instala so openssl e ca-certificates, e
# `curl` nunca esteve la — o healthcheck antigo falhava sempre, marcando o
# container unhealthy mesmo funcionando. E o alvo era /api/v1, que devolve 404;
# quem responde 200 e /api/v1/health.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
  CMD node -e "fetch('http://127.0.0.1:3001/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
